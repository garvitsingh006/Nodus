      "provider_service_id": "NEX-SVC-PAYMENT_API",
      "known_consumer_service_ids": [
        "NEX-SVC-CHECKOUT_SERVICE"
      ],
      "protocol": "HTTPS/JSON",
      "interface_category": "REST_API",
      "purpose": "Create an idempotent merchant payment intent and retrieve its current state.",
      "payload_schema": {
        "POST /v1/payment-intents request": {
          "merchant_id": "string, authenticated tenant scope",
          "amount_minor": "integer >= 1, currency minor units",
          "currency": "ISO 4217 alpha-3 string",
          "idempotency_key": "opaque string, unique within merchant operation scope",
          "merchant_order_ref?": "opaque string <= 128 chars"
        },
        "201/200 response": {
          "payment_intent_id": "string, immutable",
          "status": "CREATED|PENDING|AUTHORIZED|DECLINED|FAILED",
          "amount_minor": "integer",
          "currency": "string",
          "created_at": "RFC3339 UTC timestamp",
          "replayed": "boolean, same key and request fingerprint"
        },
        "GET /v1/payment-intents/{id} response": {
          "payment_intent_id": "string",
          "status": "CREATED|PENDING|AUTHORIZED|DECLINED|FAILED",
          "updated_at": "RFC3339 UTC timestamp"
        },
        "errors": {
          "400": "malformed fields",
          "401": "invalid identity",
          "409": "same idempotency key, different normalized payload",
          "503": "temporarily unavailable; query by stable intent id"
        }
      },
      "compatibility_expectations": "Additive optional fields only; amount units, status meanings and idempotency replay identity remain stable. Consumers ignore unknown response fields.",
      "versioning_rules": "Breaking required-field or payment-status changes publish merchant-payments-v2 with a dual-support migration period.",
      "lifecycle_status": "ACTIVE",
      "owner_employee_id": "NEX-EMP-002",
