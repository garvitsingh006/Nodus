# Set a strong password in .env. Never commit .env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# PostgreSQL is reserved for transactional task metadata and the outbox.
POSTGRES_USER=graphhacks
POSTGRES_PASSWORD=
POSTGRES_DB=graphhacks
POSTGRES_PORT=5432
# POSTGRES_DSN=postgresql://graphhacks:<password>@localhost:5432/graphhacks

# Map opaque bearer tokens to tenant, authorized workspaces and permissions.
# GRAPH_HACKS_API_PRINCIPALS_JSON={"token":{"subject":"user","tenant_id":"tenant","workspaces":["workspace"],"source_ids":["github"],"permissions":["READ_GRAPH","READ_EVIDENCE","MANAGE_INGESTION"]}}
GRAPH_HACKS_API_PRINCIPALS_JSON=

# Optional token used by scripts/import_json.py. It must match one configured principal.
GRAPH_HACKS_API_TOKEN=

# Stage 05 — Gemini model gateway (backend.app.gateway). Backend-only; never
# sent to the browser. Leave blank to disable live calls (offline tests and
# the gateway's own unit tests do not require it).
GEMINI_API_KEY=
# Role-to-model mapping. All identifiers are configurable; unset/blank
# GEMINI_MODEL_ESCALATION disables the optional escalation role entirely.
GEMINI_MODEL_LIGHTWEIGHT=gemini-3.5-flash-lite
GEMINI_MODEL_DEFAULT=gemini-3.8-flash
GEMINI_MODEL_ESCALATION=
# Optional explicit allowlist override (comma-separated). Defaults to the
# role mapping's own model set.
GEMINI_MODEL_ALLOWLIST=
# Optional pricing metadata for estimated-cost accounting, e.g.
# {"gemini-3.8-flash":{"input_per_million":0.1,"output_per_million":0.4}}
# Left blank, estimated cost is reported as unknown rather than guessed.
GEMINI_PRICING_JSON=
GEMINI_PRICING_VERSION=
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_DELAY_SECONDS=0.5
GEMINI_REQUEST_TIMEOUT_SECONDS=30
# Opt-in flag for the live Gemini smoke test (backend/tests/test_model_gateway_live.py).
GRAPH_HACKS_LIVE_GEMINI_TEST=

# Stage 05 — skill registry (backend.app.skills). Comma-separated absolute
# paths. Left blank, defaults to this repo's own skills/ directory.
GRAPH_HACKS_SKILL_ROOTS=
